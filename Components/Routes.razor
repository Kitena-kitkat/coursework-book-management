
<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                <LayoutView Layout="@typeof(MainLayout)">
                    <MudText Typo="Typo.h6" Align="Align.Center">Доступ запрещён</MudText>
                </LayoutView>
            </NotAuthorized>
            <Authorizing>
                <LayoutView Layout="@typeof(MainLayout)">
                    <MudText Typo="Typo.h6" Align="Align.Center">Проверка...</MudText>
                </LayoutView>
            </Authorizing>
        </AuthorizeRouteView>
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <MudText Typo="Typo.h6" Align="Align.Center">Страница не найдена</MudText>
        </LayoutView>
    </NotFound>
</Router>