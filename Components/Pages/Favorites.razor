@page "/favorites"
@attribute [Authorize]
@using BookManagement.Models
@using BookManagement.Services
@inject IStoryService StoryService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@rendermode RenderMode.InteractiveServer
@inject ISnackbar Snackbar
<MudSnackbarProvider/>


<MudPopoverProvider></MudPopoverProvider>
<MudText Typo="Typo.h4" Class="mb-4">⭐ Избранные рассказы</MudText>

@if (_stories.Count == 0)
{
    <MudAlert Severity="Severity.Info">
        У вас пока нет избранных рассказов. 
        <MudLink Href="/stories">Посмотреть все</MudLink>
    </MudAlert>
}
else
{
    <MudGrid Spacing="4">
        @foreach (var story in _stories)
        {
            <MudItem xs="12" sm="6" md="4">
                <StoryCard 
                    Story="story"
                    IsFavorited="true"
                    OnToggleFavorite="RemoveFromFavorites"
                    ShowFavoriteButton="true"/>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<Story> _stories = new();
    private string _currentUserId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUserId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        
        if (!string.IsNullOrEmpty(_currentUserId))
        {
            var favIds = await StoryService.GetFavoriteStoryIdsAsync(_currentUserId);
            var allStories = await StoryService.GetAllStoriesAsync();
            _stories = allStories.Where(s => favIds.Contains(s.Id)).ToList();
        }
    }

    private async Task RemoveFromFavorites(int storyId)
    {
        if (string.IsNullOrEmpty(_currentUserId)) return;
        await StoryService.ToggleFavoriteAsync(_currentUserId, storyId);
        Snackbar.Add("Рассказ удалён из избранного", Severity.Info);
        _stories.RemoveAll(s => s.Id == storyId);
        StateHasChanged();
    }
}