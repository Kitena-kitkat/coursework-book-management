@page "/login"
@attribute [AllowAnonymous]
@rendermode RenderMode.InteractiveServer

<MudGrid Justify="Justify.Center" Class="mt-8">
    <MudItem xs="12" sm="6" md="4">
        <MudPaper Elevation="3" Class="pa-6">
            <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4">Вход</MudText>

            <form method="post" action="/api/login">
                <AntiforgeryToken />

                <MudTextField T="string" @bind-Value="_userName"
                              Label="Ник" Required="true" name="UserName"
                              Margin="Margin.Dense" Variant="Variant.Outlined" FullWidth="true"/>

                <MudTextField T="string" @bind-Value="_password"
                              Label="Пароль" Required="true" InputType="InputType.Password" name="Password"
                              Margin="Margin.Dense" Variant="Variant.Outlined" FullWidth="true"/>

                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           ButtonType="ButtonType.Submit"
                           FullWidth="true" Class="mt-4">
                    Войти
                </MudButton>
            </form>
            
            <MudText Class="mt-4" Align="Align.Center">
                Нет аккаунта? <MudLink Href="/register">Зарегистрироваться</MudLink>
            </MudText>
            
            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private string _userName = string.Empty;
    private string _password = string.Empty;
    
    [Parameter] [SupplyParameterFromQuery] public string? error { get; set; }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(error))
        {
            _error = error;
        }
    }

    private string? _error;
}