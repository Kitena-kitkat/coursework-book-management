@page "/stories/{StoryId:int}"
@attribute [AllowAnonymous]
@using BookManagement.Models
@using BookManagement.Services
@inject IStoryService StoryService
@inject IReviewService ReviewService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@rendermode RenderMode.InteractiveServer

@if (_story == null)
{
    <MudAlert Severity="Severity.Error">Рассказ не найден</MudAlert>
}
else
{
    <!-- Информация о рассказе -->
    <MudPaper Elevation="2" Class="pa-4 mb-4">
        <MudText Typo="Typo.h4">@_story.BookName</MudText>
        <MudText Typo="Typo.subtitle1" Color="Color.Secondary">
            Автор: @_story.Author?.UserName • @_story.CreatedAt:dd.MM.yyyy
        </MudText>
        
        <MudRating Size="Size.Large" Disabled="true" SelectedValue="@_story.BookRating" Class="my-2"/>
        
        <MudText Class="mt-2">@_story.ShortDescription</MudText>
        <MudText Class="mt-2">@_story.FullDescription</MudText>
        
        <MudDivider Class="my-4"/>
        
        <MudStack Direction="Direction.Row" Spacing="2">
            @if (_isAuthor)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" 
                           Href=@($"/stories/{_story.Id}/edit")>✏️ Редактировать</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" 
                           OnClick="DeleteStory">🗑️ Удалить</MudButton>
            }
            @if (_currentUser != null && !_isAuthor)
            {
                <MudIconButton 
                    Icon="@(_isFavorited ? Icons.Material.Filled.Favorite : Icons.Material.Outlined.Favorite)"
                    Color="@(_isFavorited ? Color.Error : Color.Default)"
                    OnClick="ToggleFavorite"
                    Title="Добавить в избранное"/>
            }
        </MudStack>
        
        <MudDivider Class="my-4"/>
        
        <MudText Typo="Typo.h6">👍 @_likeCount 👎 @_dislikeCount</MudText>
        @if (_currentUser != null && !_isAuthor)
        {
            <MudStack Direction="Direction.Row" Spacing="2" Class="mt-2">
                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                           OnClick="@(() => ToggleStoryLike(true))">👍</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                           OnClick="@(() => ToggleStoryLike(false))">👎</MudButton>
            </MudStack>
        }
    </MudPaper>

    <!-- Отзывы -->
    <MudText Typo="Typo.h5" Class="mb-4">💬 Отзывы (@_reviews.Count)</MudText>
    
    @if (_currentUser != null)
    {
        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <MudTextField T="string" @bind-Value="_newReviewText" Label="Ваш отзыв" 
                          Lines="3" Variant="Variant.Outlined" FullWidth="true"
                          HelperText="Минимум 10 символов"/>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                       OnClick="AddReview" Class="mt-2" Disabled="string.IsNullOrWhiteSpace(_newReviewText)">
                Отправить
            </MudButton>
        </MudPaper>
    }
    
    @foreach (var review in _reviews)
    {
        <MudPaper Elevation="1" Class="pa-4 mb-2">
            <MudStack Direction="Direction.Row" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.subtitle2">
                    <strong>@review.Author?.UserName</strong> • @review.DateOfCreation:dd.MM.yyyy
                </MudText>
                @if (_currentUser != null && review.AuthorId == _currentUser.Id)
                {
                    <MudStack Direction="Direction.Row" Spacing="1">
                        <MudIconButton Icon="Icons.Material.Filled.Edit" Size="Size.Small" 
                                       OnClick="@(() => StartEditReview(review))"/>
                        <MudIconButton Icon="Icons.Material.Filled.Delete" Size="Size.Small" 
                                       Color="Color.Error" OnClick="@(() => DeleteReview(review.Id))"/>
                    </MudStack>
                }
            </MudStack>
            
            @if (_editingReviewId == review.Id)
            {
                <MudTextField T="string" @bind-Value="_editingReviewText" 
                              Lines="3" Variant="Variant.Outlined" FullWidth="true" Class="mt-2"/>
                <MudStack Direction="Direction.Row" Spacing="2" Class="mt-2">
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="@(() => SaveEditedReview(review.Id))">Сохранить</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                               OnClick="CancelEditReview">Отмена</MudButton>
                </MudStack>
            }
            else
            {
                <MudText Class="mt-2">@review.Text</MudText>
            }
            
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                👍 @review.Likes?.Count(l => l.IsLiked) | 👎 @review.Likes?.Count(l => !l.IsLiked)
            </MudText>
            
            @if (_currentUser != null)
            {
                <MudStack Direction="Direction.Row" Spacing="1" Class="mt-2">
                    <MudButton Variant="Variant.Text" Size="Size.Small" 
                               OnClick="@(() => ToggleReviewLike(review.Id, true))">👍</MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small" 
                               OnClick="@(() => ToggleReviewLike(review.Id, false))">👎</MudButton>
                </MudStack>
            }
        </MudPaper>
    }
}

@code {
    [Parameter] public int StoryId { get; set; }
    
    private Story? _story;
    private List<Review> _reviews = new();
    private ApplicationUser? _currentUser;
    private bool _isAuthor = false;
    private bool _isFavorited = false;
    private int _likeCount = 0;
    private int _dislikeCount = 0;
    private string _newReviewText = string.Empty;
    private int? _editingReviewId;
    private string _editingReviewText = string.Empty;

    protected override async Task OnInitializedAsync() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        _story = await StoryService.GetStoryByIdAsync(StoryId);
        if (_story == null) return;
        
        _reviews = await ReviewService.GetReviewsByStoryIdAsync(StoryId);
        // Сортировка: лайкнутые пользователем выше
        if (_currentUser != null)
        {
            _reviews = _reviews.OrderByDescending(r => 
                r.Likes?.Any(l => l.UserId == _currentUser.Id && l.IsLiked) == true ? 1 : 0)
                .ThenByDescending(r => r.DateOfCreation).ToList();
        }
        
        _likeCount = await StoryService.GetLikeCountAsync(StoryId, true);
        _dislikeCount = await StoryService.GetLikeCountAsync(StoryId, false);
        
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        
        if (!string.IsNullOrEmpty(userId))
        {
            _currentUser = new ApplicationUser { Id = userId };
            _isAuthor = _story.UserId == userId;
            _isFavorited = await StoryService.IsFavoriteAsync(userId, StoryId);
        }
    }

    private async Task ToggleFavorite()
    {
        if (_currentUser == null) { NavigationManager.NavigateTo("/login"); return; }
        await StoryService.ToggleFavoriteAsync(_currentUser.Id, StoryId);
        _isFavorited = !_isFavorited;
    }

    private async Task ToggleStoryLike(bool isLiked)
    {
        if (_currentUser == null) return;
        await StoryService.ToggleStoryLikeAsync(_currentUser.Id, StoryId, isLiked);
        _likeCount = await StoryService.GetLikeCountAsync(StoryId, true);
        _dislikeCount = await StoryService.GetLikeCountAsync(StoryId, false);
    }

    private async Task AddReview()
    {
        if (_currentUser == null || string.IsNullOrWhiteSpace(_newReviewText)) return;
        
        await ReviewService.CreateReviewAsync(new Review
        {
            StoryId = StoryId,
            AuthorId = _currentUser.Id,
            Text = _newReviewText
        });
        _newReviewText = string.Empty;
        await LoadDataAsync();
    }

    private async Task ToggleReviewLike(int reviewId, bool isLiked)
    {
        if (_currentUser == null) return;
        await ReviewService.ToggleReviewLikeAsync(_currentUser.Id, reviewId, isLiked);
        await LoadDataAsync();
    }

    private async Task DeleteReview(int reviewId)
    {
        if (_currentUser == null) return;
        await ReviewService.DeleteReviewAsync(reviewId);
        await LoadDataAsync();
    }

    private void StartEditReview(Review review)
    {
        _editingReviewId = review.Id;
        _editingReviewText = review.Text;
    }

    private async Task SaveEditedReview(int reviewId)
    {
        if (string.IsNullOrWhiteSpace(_editingReviewText)) return;
        await ReviewService.UpdateReviewAsync(new Review { Id = reviewId, Text = _editingReviewText });
        CancelEditReview();
        await LoadDataAsync();
    }

    private void CancelEditReview()
    {
        _editingReviewId = null;
        _editingReviewText = string.Empty;
    }

    private async Task DeleteStory()
    {
        if (_story != null && _isAuthor)
        {
            await StoryService.DeleteStoryAsync(_story.Id);
            NavigationManager.NavigateTo("/stories");
        }
    }
}