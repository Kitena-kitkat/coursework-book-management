@page "/stories/{StoryId:int}"
@attribute [AllowAnonymous]
@using BookManagement.Models
@using BookManagement.Services
@inject IStoryService StoryService
@inject IReviewService ReviewService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@rendermode RenderMode.InteractiveServer
<MudPopoverProvider></MudPopoverProvider>


@if (_story == null)
{
    <MudAlert Severity="Severity.Error">Рассказ не найден</MudAlert>
}
else
{
    <MudPaper Elevation="2" Class="pa-4 mb-4">
        <MudGrid>
            <MudItem xs="12">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Название книги</MudText>
                <MudText Typo="Typo.h6" Class="mb-3">@_story.BookName</MudText>
            </MudItem>
            
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Автор</MudText>
                <MudText Typo="Typo.body1" Class="mb-3">@_story.Author?.UserName</MudText>
            </MudItem>
            
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Дата создания</MudText>
                <MudText Typo="Typo.body1" Class="mb-3">@_story.CreatedAt.ToString("dd.MM.yyyy")</MudText>
            </MudItem>
            
            <MudItem xs="12">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Оценка книги</MudText>
                <MudRating Size="Size.Small" ReadOnly="true" SelectedValue="@_story.BookRating" Class="my-2"/>
            </MudItem>
            
            <MudItem xs="12">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Краткий рассказ</MudText>
                <MudPaper Elevation="0" Class="bg-grey-lighten-4 pa-3 rounded mt-1 mb-3">
                    <MudText Typo="Typo.body2" Style="word-wrap: break-word; white-space: pre-wrap; overflow-wrap: break-word;">
                        @_story.ShortDescription
                    </MudText>
                </MudPaper>
            </MudItem>
            
            <MudItem xs="12">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Полный рассказ</MudText>
                <MudPaper Elevation="0" Class="bg-grey-lighten-4 pa-3 rounded mt-1 mb-3">
                    <MudText Typo="Typo.body2" Style="word-wrap: break-word; white-space: pre-wrap; overflow-wrap: break-word;">
                        @_story.FullDescription
                    </MudText>
                </MudPaper>
            </MudItem>
            
            <MudItem xs="12">
                <MudDivider Class="my-2"/>
            </MudItem>
            <MudItem xs="12">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Действия</MudText>
                <div Class="d-flex align-center gap-2 mt-2">
                    @if (_isAuthor)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" 
                                   Href="@($"/stories/{_story.Id}/edit")"
                                   StartIcon="@Icons.Material.Outlined.Edit">
                            Редактировать
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" 
                                   OnClick="DeleteStory"
                                   StartIcon="@Icons.Material.Outlined.Delete">
                            Удалить
                        </MudButton>
                    }
        
                    <div Style="display: inline-flex; align-items: center;">
                        <MudTooltip Text="@(_isFavorited ? "Убрать из избранного" : "Добавить в избранное")" Placement="Placement.Top">
                            <MudIconButton
                                Icon="@(_isFavorited ? Icons.Material.Filled.Favorite : Icons.Material.Outlined.Favorite)"
                                Color="@(_isFavorited ? Color.Error : Color.Default)"
                                Size="Size.Medium"
                                OnClick="ToggleFavorite"/>
                        </MudTooltip>
                    </div>
                </div>
            </MudItem>
            
            <MudItem xs="12">
                <MudDivider Class="my-2"/>
            </MudItem>
            
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Оценка рассказа</MudText>
                <MudStack Direction="Direction.Row" Spacing="3" AlignItems="AlignItems.Center" Class="mt-1">
                    <MudStack Direction="Direction.Row" Spacing="1" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Outlined.ThumbUp" Size="Size.Small" Color="Color.Success"/>
                        <MudText Typo="Typo.body1">@_likeCount</MudText>
                    </MudStack>
                    <MudStack Direction="Direction.Row" Spacing="1" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Outlined.ThumbDown" Size="Size.Small" Color="Color.Error"/>
                        <MudText Typo="Typo.body1">@_dislikeCount</MudText>
                    </MudStack>
                </MudStack>
            </MudItem>
            
            @if (_currentUser != null)
            {
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Ваше мнение</MudText>
                    <MudStack Direction="Direction.Row" Spacing="2" Class="mt-1">
            
                        <!-- 👍 Лайк -->
                        <MudButton Variant="Variant.Outlined" 
                                   Color="@Color.Success"
                                   Size="Size.Small"
                                   StartIcon="@(_userStoryLike == true ? Icons.Material.Filled.ThumbUp : Icons.Material.Outlined.ThumbUp)"
                                   OnClick="@(() => ToggleStoryLike(true))">
                            Нравится
                        </MudButton>
            
                        <!-- 👎 Дизлайк -->
                        <MudButton Variant="Variant.Outlined" 
                                   Color="@Color.Error"
                                   Size="Size.Small"
                                   StartIcon="@(_userStoryLike == false ? Icons.Material.Filled.ThumbDown : Icons.Material.Outlined.ThumbDown)"
                                   OnClick="@(() => ToggleStoryLike(false))">
                            Не нравится
                        </MudButton>
            
                    </MudStack>
                </MudItem>
            }
        </MudGrid>
    </MudPaper>

    <MudText Typo="Typo.h6" Class="mb-4">💬 Отзывы (@_reviews.Count)</MudText>
    
    @if (_currentUser != null)
    {
        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">Напишите свой отзыв</MudText>
            <MudTextField T="string" @bind-Value="_newReviewText" 
                          Label="Текст отзыва" 
                          Lines="3" 
                          Variant="Variant.Outlined" 
                          FullWidth="true"/>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                       OnClick="AddReview" 
                       Class="mt-3"
                       Disabled="string.IsNullOrWhiteSpace(_newReviewText)"
                       StartIcon="@Icons.Material.Filled.Send">
                Отправить
            </MudButton>
        </MudPaper>
    }
    
    @foreach (var review in _reviews)
    {
        <MudPaper Elevation="1" Class="pa-4 mb-3">
            <MudText Typo="Typo.body2" Color="Color.Secondary">Текст отзыва</MudText>
            <MudText Typo="Typo.body2" Class="mt-1 mb-3" Style="word-wrap: break-word; white-space: pre-wrap; overflow-wrap: break-word;">
                @review.Text
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Автор и дата</MudText>
            <MudText Typo="Typo.body2" Class="mb-3">
                @review.Author?.UserName • @review.DateOfCreation.ToString("dd.MM.yyyy HH:mm")
            </MudText>
            
            @if (_currentUser != null && review.AuthorId == _currentUser.Id)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">Управление отзывом</MudText>
                <MudStack Direction="Direction.Row" Spacing="2" Class="mt-1 mb-3">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Outlined.Edit"
                               OnClick="@(() => StartEditReview(review))">
                        Редактировать
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                               StartIcon="@Icons.Material.Outlined.Delete"
                               OnClick="@(() => DeleteReview(review.Id))">
                        Удалить
                    </MudButton>
                </MudStack>
            }
            
            @if (_editingReviewId == review.Id)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">Редактирование</MudText>
                <MudTextField T="string" @bind-Value="_editingReviewText" 
                              Lines="3" Variant="Variant.Outlined" FullWidth="true" Class="mt-1"/>
                <MudStack Direction="Direction.Row" Spacing="2" Class="mt-2">
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="@(() => SaveEditedReview(review.Id))">
                        Сохранить
                    </MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                               OnClick="CancelEditReview">
                        Отмена
                    </MudButton>
                </MudStack>
            }
            
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-3">Оценка отзыва</MudText>
            <MudStack Direction="Direction.Row" AlignItems="AlignItems.Center" Spacing="2" Class="mt-1">
                <MudStack Direction="Direction.Row" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Outlined.ThumbUp" Size="Size.Small" Color="Color.Success"/>
                    <MudText Typo="Typo.body2">@review.Likes?.Count(l => l.IsLiked)</MudText>
                </MudStack>
                <MudStack Direction="Direction.Row" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Outlined.ThumbDown" Size="Size.Small" Color="Color.Error"/>
                    <MudText Typo="Typo.body2">@review.Likes?.Count(l => !l.IsLiked)</MudText>
                </MudStack>
            </MudStack>

            @if (_currentUser != null)
            {
                <MudStack Direction="Direction.Row" Spacing="2" Class="mt-2">
                    <MudButton Variant="Variant.Outlined" 
                               Color="@Color.Success"
                               Size="Size.Small"
                               StartIcon="@(_userReviewLikes.GetValueOrDefault(review.Id) == true ? Icons.Material.Filled.ThumbUp : Icons.Material.Outlined.ThumbUp)"
                               OnClick="@(() => ToggleReviewLike(review.Id, true))">
                        Нравится
                    </MudButton>
        
                    <MudButton Variant="Variant.Outlined" 
                               Color="@Color.Error"
                               Size="Size.Small"
                               StartIcon="@(_userReviewLikes.GetValueOrDefault(review.Id) == false ? Icons.Material.Filled.ThumbDown : Icons.Material.Outlined.ThumbDown)"
                               OnClick="@(() => ToggleReviewLike(review.Id, false))">
                        Не нравится
                    </MudButton>
                </MudStack>
            }
        </MudPaper>
    }
}

@code {
    [Parameter] public int StoryId { get; set; }
    
    private Story? _story;
    private List<Review> _reviews = new();
    private ApplicationUser? _currentUser;
    private bool _isAuthor = false;
    private bool _isFavorited = false;
    private int _likeCount = 0;
    private int _dislikeCount = 0;
    private string _newReviewText = string.Empty;
    private int? _editingReviewId;
    private string _editingReviewText = string.Empty;
    private bool? _userStoryLike;  // true = лайк, false = дизлайк, null = ничего
    private Dictionary<int, bool?> _userReviewLikes = new();  // reviewId → like state


    protected override async Task OnInitializedAsync() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        _story = await StoryService.GetStoryByIdAsync(StoryId);
        if (_story == null) return;
    
        _reviews = await ReviewService.GetReviewsByStoryIdAsync(StoryId);
        _likeCount = await StoryService.GetLikeCountAsync(StoryId, true);
        _dislikeCount = await StoryService.GetLikeCountAsync(StoryId, false);
    
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    
        if (!string.IsNullOrEmpty(userId))
        {
            _currentUser = new ApplicationUser { Id = userId };
            _isAuthor = _story.UserId == userId;
            _isFavorited = await StoryService.IsFavoriteAsync(userId, StoryId);
        
            _userStoryLike = await StoryService.GetUserStoryLikeAsync(userId, StoryId);
        
            foreach (var review in _reviews)
            {
                _userReviewLikes[review.Id] = await ReviewService.GetUserReviewLikeAsync(userId, review.Id);
            }
        }
    }

    private async Task ToggleFavorite()
    {
        if (_currentUser == null) { NavigationManager.NavigateTo("/login"); return; }
        await StoryService.ToggleFavoriteAsync(_currentUser.Id, StoryId);
        _isFavorited = !_isFavorited;
    }

    private async Task ToggleStoryLike(bool isLiked)
    {
        if (_currentUser == null) return;
    
        // Если кликнули на уже активную кнопку → null (снять), иначе → новое значение
        var newLike = (_userStoryLike == isLiked) ? (bool?)null : isLiked;
    
        await StoryService.ToggleStoryLikeAsync(_currentUser.Id, StoryId, newLike);
        _userStoryLike = newLike;
    
        _likeCount = await StoryService.GetLikeCountAsync(StoryId, true);
        _dislikeCount = await StoryService.GetLikeCountAsync(StoryId, false);
    
        StateHasChanged();
    }

    private async Task AddReview()
    {
        if (_currentUser == null || string.IsNullOrWhiteSpace(_newReviewText)) return;
        
        await ReviewService.CreateReviewAsync(new Review
        {
            StoryId = StoryId,
            AuthorId = _currentUser.Id,
            Text = _newReviewText,
            DateOfCreation = DateTime.UtcNow
        });
        _newReviewText = string.Empty;
        await LoadDataAsync();
        StateHasChanged();
    }

    private async Task ToggleReviewLike(int reviewId, bool isLiked)
    {
        if (_currentUser == null) return;
    
        var current = _userReviewLikes.GetValueOrDefault(reviewId);
        var newLike = (current == isLiked) ? (bool?)null : isLiked;
    
        await ReviewService.ToggleReviewLikeAsync(_currentUser.Id, reviewId, newLike);
        _userReviewLikes[reviewId] = newLike;
    
        await LoadDataAsync();
        StateHasChanged();
    }

    private async Task DeleteReview(int reviewId)
    {
        if (_currentUser == null) return;
        await ReviewService.DeleteReviewAsync(reviewId, _currentUser.Id);
        await LoadDataAsync();
        StateHasChanged();
    }

    private void StartEditReview(Review review)
    {
        _editingReviewId = review.Id;
        _editingReviewText = review.Text;
    }

    private async Task SaveEditedReview(int reviewId)
    {
        if (string.IsNullOrWhiteSpace(_editingReviewText)) return;
        await ReviewService.UpdateReviewAsync(new Review { Id = reviewId, Text = _editingReviewText }, _currentUser?.Id);
        CancelEditReview();
        await LoadDataAsync();
        StateHasChanged();
    }

    private void CancelEditReview()
    {
        _editingReviewId = null;
        _editingReviewText = string.Empty;
    }

    private async Task DeleteStory()
    {
        if (_story != null && _isAuthor)
        {
            await StoryService.DeleteStoryAsync(_story.Id, _currentUser!.Id);
            NavigationManager.NavigateTo("/stories");
        }
    }
}