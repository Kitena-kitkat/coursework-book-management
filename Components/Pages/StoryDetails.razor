@page "/stories/{StoryId:int}"
@attribute [AllowAnonymous]
@using BookManagement.Models
@using BookManagement.Services
@inject IStoryService StoryService
@inject IReviewService ReviewService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@rendermode RenderMode.InteractiveServer

<MudSnackbarProvider/>
<MudPopoverProvider/>
<MudDialogProvider/>

@if (_story == null)
{
    <MudAlert Severity="Severity.Error">Рассказ не найден</MudAlert>
    <MudButton Href="/stories">← Назад</MudButton>
}
else
{
    <MudCard Elevation="2" Class="mb-4">
        <MudCardContent Class="pb-1">
            
            <div class="d-flex justify-space-between align-start w-100 mb-3">
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Книга</MudText>
                    <MudText Typo="Typo.h5">@_story.BookName</MudText>
                </div>
                @if (_isAuthor)
                {
                    <MudTooltip Text="Управление" Placement="Placement.Top">
                        <MudMenu Icon="@Icons.Material.Filled.Settings" Size="Size.Small" Color="Color.Primary">
                            <MudMenuItem Href=@($"/stories/{_story.Id}/edit")>
                                <MudIcon Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" Color="Color.Primary"/>
                                <MudText Class="ml-2">Редактировать</MudText>
                            </MudMenuItem>
                            <MudMenuItem OnClick="ConfirmDeleteStory">
                                <MudIcon Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error"/>
                                <MudText Class="ml-2" Color="Color.Error">Удалить</MudText>
                            </MudMenuItem>
                        </MudMenu>
                    </MudTooltip>
                }
            </div>
            
            <MudDivider Class="mb-3"/>
            
            <MudStack Spacing="4" Class="mb-3">
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Автор</MudText>
                    <MudText Typo="Typo.body2">@_story.Author?.UserName</MudText>
                </div>
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Дата</MudText>
                    <MudText Typo="Typo.body2">@_story.CreatedAt.ToString("dd.MM.yyyy")</MudText>
                </div>
            </MudStack>
            
            <MudDivider Class="mb-3"/>
            
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Оценка книги</MudText>
            <MudRating Size="Size.Small" ReadOnly="true" SelectedValue="@_story.BookRating" Class="mb-3"/>
            
            <MudDivider Class="mb-3"/>
            
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Коротко</MudText>
            <MudText Typo="Typo.body2" Class="mb-3" Style="white-space: pre-wrap; word-wrap: break-word;">@_story.ShortDescription</MudText>
            
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Подробно</MudText>
            <MudText Typo="Typo.body2" Style="white-space: pre-wrap; word-wrap: break-word;">@_story.FullDescription</MudText>
            
            <MudDivider Class="my-3"/>
            
            <div class="d-flex align-center flex-nowrap mt-2" style="gap: 6px;">
                @if (_currentUser != null)
                {
                    <MudTooltip Text="Рассказ нравится" Placement="Placement.Top">
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   OnClick="@(() => ToggleStoryLike(true))"
                                   StartIcon="@GetStoryLikeIcon()"
                                   Color="@GetStoryLikeColor()"
                                   Style="min-width: 0; padding: 0 4px;">
                            @_likeCount
                        </MudButton>
                    </MudTooltip>
                    <MudTooltip Text="Рассказ не нравится" Placement="Placement.Top">
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   OnClick="@(() => ToggleStoryLike(false))"
                                   StartIcon="@GetStoryDislikeIcon()"
                                   Color="@GetStoryDislikeColor()"
                                   Style="min-width: 0; padding: 0 4px;">
                            @_dislikeCount
                        </MudButton>
                    </MudTooltip>

                    <MudTooltip Text="@(_isFavorited ? "Убрать из избранного" : "В избранное")" Placement="Placement.Top">
                        <MudIconButton 
                            Icon="@(_isFavorited ? Icons.Material.Filled.Favorite : Icons.Material.Outlined.Favorite)"
                            Color="@(_isFavorited ? Color.Error : Color.Default)"
                            Size="Size.Small"
                            OnClick="ToggleFavorite"
                            Style="padding: 0 4px;"/>
                    </MudTooltip>
                }
                else
                {
                    <div class="d-flex align-center" style="gap: 8px;">
                        <MudText Typo="Typo.caption" Class="ma-0">👍 @_likeCount</MudText>
                        <MudText Typo="Typo.caption" Class="ma-0">👎 @_dislikeCount</MudText>
                    </div>
                }
            </div>
            
        </MudCardContent>
    </MudCard>

    <MudText Typo="Typo.h6" Class="mb-3">Отзывы (@_reviews.Count)</MudText>
    
    @if (_currentUser != null)
    {
        <MudCard Elevation="1" Class="mb-4">
            <MudCardContent>
                <MudTextField T="string" @bind-Value="_newReviewText" 
                              Label="Ваш отзыв" Lines="2" 
                              Variant="Variant.Outlined" FullWidth="true"/>
                <MudButton Variant="Variant.Filled" Size="Size.Small" 
                           OnClick="AddReview" Class="mt-2"
                           Disabled="@string.IsNullOrWhiteSpace(_newReviewText)" Color="Color.Primary">
                    Отправить
                </MudButton>
            </MudCardContent>
        </MudCard>
    }
    
    @if (_reviews.Count == 0)
    {
        <MudAlert Severity="Severity.Info">Пока нет отзывов</MudAlert>
    }
    else
    {
        @foreach (var review in _reviews)
        {
            <MudCard Elevation="1" Class="mb-3">
                <MudCardContent Class="pb-1">
                    
                    <div class="d-flex justify-space-between align-start mb-1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Отзыв</MudText>
                        
                        @if (review.AuthorId == _currentUser?.Id)
                        {
                            <MudTooltip Text="Управление" Placement="Placement.Top">
                                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Color="Color.Primary"
                                         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                    <MudMenuItem OnClick="@(() => StartEditReview(review))">
                                        <MudIcon Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" Color="Color.Primary"/>
                                        <MudText Class="ml-2">Редактировать</MudText>
                                    </MudMenuItem>
                                    <MudMenuItem OnClick="@(() => ConfirmDeleteReview(review.Id))">
                                        <MudIcon Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error"/>
                                        <MudText Class="ml-2" Color="Color.Error">Удалить</MudText>
                                    </MudMenuItem>
                                </MudMenu>
                            </MudTooltip>
                        }
                    </div>
                    
                    @if (_editingReviewId == review.Id)
                    {
                        <MudTextField T="string" @bind-Value="_editingReviewText" 
                                      Lines="3" Variant="Variant.Outlined" FullWidth="true" Class="mb-2"/>
                        <MudStack Spacing="2">
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                       OnClick="@(() => SaveEditedReview(review.Id))">💾 Сохранить</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="CancelEditReview">✕ Отмена</MudButton>
                        </MudStack>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Class="mb-2" Style="white-space: pre-wrap; word-wrap: break-word;">
                            @review.Text
                        </MudText>
                    }
                    
                    <MudDivider Class="my-2"/>
                    
                    <MudStack Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Class="mb-2">
                        <MudStack>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Автор</MudText>
                            <MudText Typo="Typo.body2">@review.Author?.UserName</MudText>
                        </MudStack>
                        <MudStack>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Дата</MudText>
                            <MudText Typo="Typo.body2">@review.DateOfCreation.ToString("dd.MM.yyyy HH:mm")</MudText>
                        </MudStack>
                    </MudStack>
                    
                    <MudDivider Class="my-2"/>
                    
                    <div class="d-flex align-center flex-nowrap mt-2" style="gap: 6px;">
                        @if (_currentUser != null)
                        {
                            <MudTooltip Text="Отзыв нравится" Placement="Placement.Top">
                                <MudButton Variant="Variant.Text" Size="Size.Small"
                                           OnClick="@(() => ToggleReviewLike(review.Id, true))"
                                           StartIcon="@GetReviewLikeIcon(review.Id)"
                                           Color="@GetReviewLikeColor(review.Id)"
                                           Style="min-width: 0; padding: 0 4px;">
                                    @(review.Likes?.Count(l => l.IsLiked) ?? 0)
                                </MudButton>
                            </MudTooltip>

                            <MudTooltip Text="Отзыв не нравится" Placement="Placement.Top">
                                <MudButton Variant="Variant.Text" Size="Size.Small"
                                           OnClick="@(() => ToggleReviewLike(review.Id, false))"
                                           StartIcon="@GetReviewDislikeIcon(review.Id)"
                                           Color="@GetReviewDislikeColor(review.Id)"
                                           Style="min-width: 0; padding: 0 4px;">
                                    @(review.Likes?.Count(l => !l.IsLiked) ?? 0)
                                </MudButton>
                            </MudTooltip>

                        }
                        else
                        {
                            <div class="d-flex align-center" style="gap: 8px;">
                                <MudText Typo="Typo.caption" Class="ma-0">👍 @(review.Likes?.Count(l => l.IsLiked) ?? 0)</MudText>
                                <MudText Typo="Typo.caption" Class="ma-0">👎 @(review.Likes?.Count(l => !l.IsLiked) ?? 0)</MudText>
                            </div>
                        }
                    </div>
                    
                </MudCardContent>
            </MudCard>
        }
    }
}

@code {
    [Parameter] public int StoryId { get; set; }
    
    private Story? _story;
    private List<Review> _reviews = new();
    private ApplicationUser? _currentUser;
    private bool _isAuthor = false;
    private bool _isFavorited = false;
    private int _likeCount = 0;
    private int _dislikeCount = 0;
    private string _newReviewText = string.Empty;
    private int? _editingReviewId;
    private string _editingReviewText = string.Empty;
    private bool? _userStoryLike;
    private Dictionary<int, bool?> _userReviewLikes = new();

    protected override async Task OnInitializedAsync() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        _story = await StoryService.GetStoryByIdAsync(StoryId);
        if (_story == null) return;
        
        _reviews = await ReviewService.GetReviewsByStoryIdAsync(StoryId);
        _likeCount = await StoryService.GetLikeCountAsync(StoryId, true);
        _dislikeCount = await StoryService.GetLikeCountAsync(StoryId, false);
        
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        
        if (!string.IsNullOrEmpty(userId))
        {
            _currentUser = new ApplicationUser { Id = userId };
            _isAuthor = _story.UserId == userId;
            _isFavorited = await StoryService.IsFavoriteAsync(userId, StoryId);
            _userStoryLike = await StoryService.GetUserStoryLikeAsync(userId, StoryId);
            
            foreach (var r in _reviews)
                _userReviewLikes[r.Id] = await ReviewService.GetUserReviewLikeAsync(userId, r.Id);
        }
        StateHasChanged();
    }

    private string GetStoryLikeIcon() => _userStoryLike == true ? Icons.Material.Filled.ThumbUp : Icons.Material.Outlined.ThumbUp;
    private Color GetStoryLikeColor() => _userStoryLike == true ? Color.Primary : Color.Default;
    private string GetStoryDislikeIcon() => _userStoryLike == false ? Icons.Material.Filled.ThumbDown : Icons.Material.Outlined.ThumbDown;
    private Color GetStoryDislikeColor() => _userStoryLike == false ? Color.Error : Color.Default;

    private string GetReviewLikeIcon(int id) => _userReviewLikes.GetValueOrDefault(id) == true ? Icons.Material.Filled.ThumbUp : Icons.Material.Outlined.ThumbUp;
    private Color GetReviewLikeColor(int id) => _userReviewLikes.GetValueOrDefault(id) == true ? Color.Primary : Color.Default;
    private string GetReviewDislikeIcon(int id) => _userReviewLikes.GetValueOrDefault(id) == false ? Icons.Material.Filled.ThumbDown : Icons.Material.Outlined.ThumbDown;
    private Color GetReviewDislikeColor(int id) => _userReviewLikes.GetValueOrDefault(id) == false ? Color.Error : Color.Default;

    private async Task ToggleStoryLike(bool isLiked)
    {
        if (_currentUser == null) return;
        var newLike = (_userStoryLike == isLiked) ? (bool?)null : isLiked;
        await StoryService.ToggleStoryLikeAsync(_currentUser.Id, StoryId, newLike);
        if (newLike is true)
        {
            Snackbar.Add("Вы поставили лайк рассказу", Severity.Success);
        }

        else if (newLike is false)
        {
            Snackbar.Add("Вы поставили дизлайк рассказу", Severity.Info);
        }
        else
        {
            Snackbar.Add("Вы убрали свою оценку рассказу");
        }
        _userStoryLike = newLike;
        _likeCount = await StoryService.GetLikeCountAsync(StoryId, true);
        _dislikeCount = await StoryService.GetLikeCountAsync(StoryId, false);
        StateHasChanged();
    }

    private async Task ToggleReviewLike(int reviewId, bool isLiked)
    {
        if (_currentUser == null) return;
        var current = _userReviewLikes.GetValueOrDefault(reviewId);
        var newLike = (current == isLiked) ? (bool?)null : isLiked;
        if (newLike is true)
        {
            Snackbar.Add("Вы поставили лайк отзыву", Severity.Success);
        }

        else if (newLike is false)
        {
            Snackbar.Add("Вы поставили дизлайк отзыву", Severity.Info);
        }
        else
        {
            Snackbar.Add("Вы убрали свою оценку отзыву");
        }
        await ReviewService.ToggleReviewLikeAsync(_currentUser.Id, reviewId, newLike);
        _userReviewLikes[reviewId] = newLike;
        await LoadDataAsync();
    }

    private async Task ToggleFavorite()
    {
        if (_currentUser == null) { NavigationManager.NavigateTo("/login", forceLoad: true); return; }
        await StoryService.ToggleFavoriteAsync(_currentUser.Id, StoryId);
        if (_isFavorited)
        {
            Snackbar.Add("Рассказ успешно удален из избранного", Severity.Info);
        }
        else
        {
            Snackbar.Add("Рассказ успешно добавлен в избранное", Severity.Success);
        }
        _isFavorited = !_isFavorited;
        StateHasChanged();
    }

    private async Task AddReview()
    {
        if (_currentUser == null || string.IsNullOrWhiteSpace(_newReviewText)) return;
        await ReviewService.CreateReviewAsync(new Review { StoryId = StoryId, AuthorId = _currentUser.Id, Text = _newReviewText, });
        Snackbar.Add("Отзыв успешно добавлен!", Severity.Success);
        _newReviewText = string.Empty;
        await LoadDataAsync();
    }

    private void StartEditReview(Review review) 
    { 
        _editingReviewId = review.Id; 
        _editingReviewText = review.Text; 
        StateHasChanged();
    }

    private async Task SaveEditedReview(int reviewId)
    {
        if (string.IsNullOrWhiteSpace(_editingReviewText) || _currentUser is null) return;
        await ReviewService.UpdateReviewAsync(new Review { Id = reviewId, Text = _editingReviewText }, _currentUser.Id);
        Snackbar.Add("Отзыв успешно обновлен!", Severity.Success);
        CancelEditReview();
        await LoadDataAsync();
    }

    private void CancelEditReview() 
    { 
        _editingReviewId = null; 
        _editingReviewText = string.Empty; 
        StateHasChanged();
    }

    private async Task ConfirmDeleteStory()
    {
        var result = await DialogService.ShowMessageBoxAsync(
            "Подтверждение удаления", 
            $"Вы уверены, что хотите удалить рассказ \"{_story?.BookName}\"?",
            yesText: "Удалить", 
            cancelText: "Отмена");
        
        if (result == true && _currentUser != null && _story != null)
        {
            await StoryService.DeleteStoryAsync(_story.Id, _currentUser.Id);
            NavigationManager.NavigateTo("/stories", forceLoad: true);
        }
    }

    private async Task ConfirmDeleteReview(int reviewId)
    {
        var result = await DialogService.ShowMessageBoxAsync(
            "Подтверждение удаления",
            "Вы уверены, что хотите удалить этот отзыв?",
            yesText: "Удалить", 
            cancelText: "Отмена");
        
        if (result == true && _currentUser != null)
        {
            await ReviewService.DeleteReviewAsync(reviewId, _currentUser.Id);
            Snackbar.Add("Отзыв успешно удален", Severity.Success);
            await LoadDataAsync();
        }
    }
}