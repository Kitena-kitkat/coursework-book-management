@page "/stories/{StoryId:int}/edit"
@attribute [Authorize]
@using BookManagement.Models
@using BookManagement.Services
@using System.ComponentModel.DataAnnotations
@inject IStoryService StoryService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@rendermode RenderMode.InteractiveServer

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true"/>
}
else if (_story == null)
{
    <MudAlert Severity="Severity.Error">Рассказ не найден</MudAlert>
}
else if (!_isAuthor)
{
    <MudAlert Severity="Severity.Warning">Вы не можете редактировать этот рассказ</MudAlert>
}
else
{
    <MudText Typo="Typo.h4" Class="mb-4">✏️ Редактировать рассказ</MudText>

    <MudPaper Elevation="2" Class="pa-6">
        <MudForm @ref="_form" Model="@_formModel" @bind-IsValid="@_isValid" @bind-Errors="@_errors">
            <MudTextField T="string" @bind-Value="_formModel.BookName" 
                          Label="Название книги" 
                          Required="true"
                          RequiredError="Введите название книги"
                          HelperText="Например: Мастер и Маргарита"
                          Margin="Margin.Dense" 
                          Variant="Variant.Outlined" 
                          FullWidth="true"
                          For="@(() => _formModel.BookName)"/>
            
            <MudTextField T="string" @bind-Value="_formModel.ShortDescription" 
                          Label="Короткое описание" 
                          Required="true" 
                          RequiredError="Введите короткое описание"
                          Counter="200"
                          HelperText="2-3 предложения о вашем впечатлении"
                          Margin="Margin.Dense" 
                          Variant="Variant.Outlined" 
                          FullWidth="true"
                          Lines="2"
                          For="@(() => _formModel.ShortDescription)"/>
            
            <MudTextField T="string" @bind-Value="_formModel.FullDescription" 
                          Label="Полное описание" 
                          Required="true"
                          RequiredError="Введите полное описание"
                          HelperText="Подробно опишите ваш опыт чтения"
                          Margin="Margin.Dense" 
                          Variant="Variant.Outlined" 
                          FullWidth="true"
                          Lines="6"
                          For="@(() => _formModel.FullDescription)"/>
            
            <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">Оценка книги</MudText>
            
            <MudRating @bind-SelectedValue="_formModel.BookRating"/>
            
            @if (_errors.Any())
            {
                <MudAlert Severity="Severity.Error" Class="mt-4">
                    <ul>
                        @foreach (var error in _errors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </MudAlert>
            }
            
            <MudStack Direction="Direction.Row" Spacing="2" Class="mt-4">
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           OnClick="HandleSubmit"
                           Disabled="@(!_isValid || _isSaving)">
                    @if (_isSaving)
                    {
                        <MudProgressCircular Color="Color.Inherit" Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                    }
                    Сохранить
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" 
                           Href="@($"/stories/{_story.Id}")">Отмена</MudButton>
            </MudStack>
        </MudForm>
    </MudPaper>
}

@code {
    [Parameter] public int StoryId { get; set; }
    
    private MudForm _form = new();
    private Story? _story;
    private EditStoryFormModel _formModel = new();
    private bool _isLoading = true;
    private bool _isSaving = false;
    private bool _isAuthor = false;
    private bool _isValid;
    private string[] _errors = Array.Empty<string>();

    protected override async Task OnInitializedAsync()
    {
        _story = await StoryService.GetStoryByIdAsync(StoryId);
        
        if (_story != null)
        {
            _formModel = new EditStoryFormModel
            {
                BookName = _story.BookName,
                ShortDescription = _story.ShortDescription,
                FullDescription = _story.FullDescription,
                BookRating = _story.BookRating
            };

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var currentUserId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            _isAuthor = currentUserId == _story.UserId;
        }
        
        _isLoading = false;
    }

    private async Task HandleSubmit()
    {
        await _form.ValidateAsync();
        
        if (!_isValid)
        {
            return;
        }

        if (_story == null) return;

        _isSaving = true;

        try
        {
            _story.BookName = _formModel.BookName;
            _story.ShortDescription = _formModel.ShortDescription;
            _story.FullDescription = _formModel.FullDescription;
            _story.BookRating = _formModel.BookRating;
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            
            if (string.IsNullOrEmpty(userId))
            {
                NavigationManager.NavigateTo("/login", forceLoad: true);
                return;
            }
            
            var success = await StoryService.UpdateStoryAsync(_story, userId);
            if (success)
            {
                NavigationManager.NavigateTo($"/stories/{_story.Id}", forceLoad: true);
            }
            else
            {
                _errors = new[] { "Ошибка при сохранении или недостаточно прав" };
            }
            NavigationManager.NavigateTo($"/stories/{_story.Id}", forceLoad: true);
        }
        catch (Exception ex)
        {
            _errors = new[] { "Ошибка при сохранении: " + ex.Message };
        }
        finally
        {
            _isSaving = false;
        }
    }

    private class EditStoryFormModel
    {
        [Required(ErrorMessage = "Обязательное поле")]
        [StringLength(200, MinimumLength = 3, ErrorMessage = "Название должно быть от 3 до 200 символов")]
        public string BookName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Обязательное поле")]
        [StringLength(500, MinimumLength = 10, ErrorMessage = "Описание должно быть от 10 до 500 символов")]
        public string ShortDescription { get; set; } = string.Empty;

        [Required(ErrorMessage = "Обязательное поле")]
        [StringLength(5000, MinimumLength = 50, ErrorMessage = "Подробное описание должно быть от 50 до 5000 символов")]
        public string FullDescription { get; set; } = string.Empty;

        [Required(ErrorMessage = "Поставьте оценку")]
        [Range(1, 5, ErrorMessage = "Оценка должна быть от 1 до 5")]
        public int BookRating { get; set; }
    }
}