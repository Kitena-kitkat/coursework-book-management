@page "/register"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Identity
@using BookManagement.Models
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@rendermode RenderMode.InteractiveServer

<MudText Typo="Typo.h5" Class="mb-4">Регистрация</MudText>

<MudForm @ref="_form" Model="@_formModel">
    <MudTextField T="string" @bind-Value="_formModel.UserName" 
                  Label="Имя пользователя" Required="true"
                  HelperText="3-50 символов"
                  Margin="Margin.Dense" Variant="Variant.Outlined" FullWidth="true"/>
    
    <MudTextField T="string" @bind-Value="_formModel.Password" 
                  Label="Пароль" Required="true" InputType="InputType.Password"
                  HelperText="Минимум 6 символов"
                  Margin="Margin.Dense" Variant="Variant.Outlined" FullWidth="true"/>
    
    <MudButton Variant="Variant.Filled" Color="Color.Primary" 
               OnClick="HandleRegister" Class="mt-4"
               Loading="_isLoading" ButtonType="ButtonType.Button">
        Зарегистрироваться
    </MudButton>
    
    <MudText Class="mt-2">
        Уже есть аккаунт? <MudLink Href="/login">Войти</MudLink>
    </MudText>
    
    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
    }
</MudForm>

@code {
    private MudForm _form = new();
    private RegisterFormModel _formModel = new();
    private string _error = string.Empty;
    private bool _isLoading = false;

    private async Task HandleRegister()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _isLoading = true; _error = string.Empty;

        try
        {
            var user = new ApplicationUser
            {
                UserName = _formModel.UserName,
                Email = _formModel.UserName, // Identity требует Email, но он не используется
                DateOfRegistration = DateTime.UtcNow
            };

            var result = await UserManager.CreateAsync(user, _formModel.Password);

            if (result.Succeeded)
            {
                NavigationManager.NavigateTo("/login", forceLoad: true);
            }
            else
            {
                var dup = result.Errors.FirstOrDefault(e => e.Code == "DuplicateUserName");
                _error = dup != null ? "Такое имя пользователя уже занято" 
                                     : result.Errors.FirstOrDefault()?.Description ?? "Ошибка регистрации";
            }
        }
        catch (Exception ex) { _error = "Ошибка: " + ex.Message; }
        finally { _isLoading = false; }
    }

    private class RegisterFormModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(50, MinimumLength = 3)]
        public string UserName { get; set; } = string.Empty;
        
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(100, MinimumLength = 6)]
        public string Password { get; set; } = string.Empty;
    }
}